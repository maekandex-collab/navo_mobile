# ==========================================================
# Navo Plus Mobile - Environment Configuration
# ==========================================================
# Copy this file to .env or .env.local for local development.
# In Expo SDK 49+, all variables prefixed with EXPO_PUBLIC_
# are automatically bundled and accessible in JavaScript/TypeScript.

# Backend API Base URL
EXPO_PUBLIC_SERVER_URI=https://navoapi.viaspark.site/api/v1

# API Authentication Key (sent in 'expo-api-key' request header)
EXPO_PUBLIC_API_KEY=your_api_key_here

# Stripe Publishable Key (used by StripeProvider for card transactions)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Base URL for user profile photos and uploaded media assets
EXPO_PUBLIC_IMAGE_URI=https://navoapi.viaspark.site/
